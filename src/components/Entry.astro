---
const { title, date } = Astro.props;
---

<details class="group z-100 left-4 right-4 px-4 py-2 my-4 bg-black/25 border-2 border-white/20 rounded-4xl backdrop-blur-md overflow-hidden">
    <summary class="flex justify-between items-center py-1 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <p class="text-neutral-300 text-xl truncate">{title}</p>

        <div class="flex items-center gap-2.5">
            <p class="text-neutral-400">{date}</p>

            <svg class="transition-transform duration-300 group-open:rotate-180 text-neutral-300" width="48" height="48" viewBox="0 0 48 48">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M36 18L24 30L12 18" />
            </svg>
        </div>
    </summary>

    <div class="-mx-4 -mb-2 mt-2 border-t border-white/20 bg-white/10 px-4 py-5">
        <slot />
    </div>
</details>
