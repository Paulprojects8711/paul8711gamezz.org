---
import "../../../styles/global.css";
import Footer from "../../../components/Footer.astro";
import Bar from "../../../components/Bar.astro";
import Layout from "../../../layouts/Layout.astro";
---
<Layout title="ion-mail - Vektrace" desc="Discover ion-mail, a mail CLI written in Rust supporting all mail functions & OAuth2 login." favicon="/favicon.png">
    <main class="min-h-dvh bg-black bg-linear-120 from-[#00312e] via-transparent to-[#002b00] pt-15 pb-32">
        <Bar title="ion-mail" link="/projects" />
        <div class="mt-10 p-4">
            <p class="text-neutral-300 text-xl text-center mb-12.5">Mail CLI in Rust supporting all mail functions & OAuth2 login</p>

            <a href="https://github.com/vektrace/ion-mail/releases/latest" class="block w-full max-w-100 mx-auto
                m-5 p-4 bg-black/25 text-center
                border-2 border-white/20 rounded-3xl backdrop-blur-md
                transition-all duration-300 ease-out
                hover:shadow-lg hover:border-white/50 hover:shadow-neutral-600 hover:-translate-y-1 hover:bg-white/5
                focus:shadow-lg focus:border-white/50 focus:shadow-neutral-600 focus:-translate-y-1 focus:bg-white/5"
            >
                <p class="text-white text-xl">Download on Github</p>
            </a>

            <a href="/projects/ion-mail/wiki" class="block w-full max-w-80 mx-auto
                m-5 p-2 bg-black/25 text-center
                border-2 border-white/20 rounded-full backdrop-blur-md
                transition-all duration-300 ease-out
                hover:shadow-lg hover:border-white/50 hover:shadow-neutral-600 hover:-translate-y-1 hover:bg-white/5
                focus:shadow-lg focus:border-white/50 focus:shadow-neutral-600 focus:-translate-y-1 focus:bg-white/5"
            >
                <p class="text-white text-lg">Wiki</p>
            </a>

            <h1 class="text-white text-2xl text-center mb-2.5">Info</h1>
            <p class="text-neutral-300 text-xl text-center mb-2.5">ion-mail is a CLI used for sending and receiving mail.</p>
            <p class="text-neutral-300 text-xl text-center mb-12.5">All Email providers (Microsoft partially) are supported.</p>

            <p class="text-neutral-300 text-xl text-center mb-12.5">Before using this tool you might want to have a look at the <a href="/projects/ion-mail/wiki" class="link">Wiki</a>.</p>

            <h1 class="text-white text-2xl text-center mb-2.5">Contributing</h1>
            <p class="text-neutral-300 text-bold text-xl text-center mb-12.5">If you want to contribute, feel free to open a pull request on <a class="link" href="https://github.com/vektrace/ion-mail">Github</a>.</p>

            <div class="flex justify-center items-center mb-12.5">
                <a href="https://github.com/vektrace/ion-mail" target="_blank" class="text-neutral-300 hover:text-neutral-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                        <title>meteorite on Github</title>
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor" d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" />
                    </svg>
                </a>
            </div>

            <div class="flex justify-center items-center">
                <script type='text/javascript' src='https://storage.ko-fi.com/cdn/widget/Widget_2.js'></script>
                <script type='text/javascript'>kofiwidget2.init('Support me on Ko-fi', '#303030', 'U7U61QBY0C'); kofiwidget2.draw();</script>
            </div>
        </div>
        <Footer />
    </main>
</Layout>
