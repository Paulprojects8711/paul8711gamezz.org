---
const { title, desc, favicon } = Astro.props;
---
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content={desc}>
        <title>{title}</title>
        <link rel="icon" type="image/png" href={favicon}>
    </head>

    <body class="bg-black">
        <slot />
    </body>
</html>
