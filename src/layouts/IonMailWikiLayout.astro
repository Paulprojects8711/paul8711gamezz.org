---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Bar from "../components/Bar.astro";
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---
<Layout title="ion-mail Wiki - Paul8711" desc="Learn more about ion-mail in the wiki. Find out how to use the CLI or how to set up OAuth 2.0 with your email provider." favicon="/favicon.png">
    <main class="min-h-dvh bg-black bg-linear-120 from-[#00312e] via-transparent to-[#002b00] pt-15 pb-32">
        <Bar title={frontmatter.title} link="/projects/ion-mail/wiki" />
        <div
            class="prose
            prose-headings:text-white
            prose-headings:font-medium prose-headings:scroll-mt-25
            prose-code:text-white
            prose-p:text-neutral-400 prose-strong:text-white
            prose-h1:mb-5 prose-h2:mt-6
            prose-img:m-0 prose-img:inline-block
            prose-ul:text-left prose-ul:inline-block prose-ul:m-0
            prose-li:text-neutral-300 prose-li:my-0
            text-center mx-auto mt-10 p-4"
        >
            <slot />
        </div>
        <Footer />
    </main>
</Layout>
